# Local environment / machine-specific paths
.env

# Game installs, mod tools, and extracted archives must never enter the repo
# (paths from .env, kept local-only; see CLAUDE.md "Rules")
*.map
*.pak
*.ucas
*.utoc
*.fsb
*.wav
*.ogg
*.bnk
*.wem
*.7z

# Scratch space for any local extraction/inspection work
/scratch/
/reference-audio/
/extracted/
/work/
/mappings/*.local.json
/mappings/.history/

# Python artifacts
__pycache__/
*.pyc

# SQLite decision store (mapping_store is its only writer). The JSON is its export.
/mappings/*.db
/mappings/*.db-journal
/mappings/*.tmp

# Studio frontend: dependencies and build output
frontend/node_modules/
frontend/dist/
