{
  "name": "halo-mcc-localization-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local UI for the Halo MCC Latin American Spanish localization. Talks to scripts/ui/m4_server.py.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python ../scripts/ui/m4_server.py --no-open",
    "dev:web": "vite",
    "serve": "python ../scripts/ui/m4_server.py --no-open",
    "host": "npm run build && python ../scripts/ui/m4_server.py --lan --no-open",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "compare:m4": "node e2e/compare-m4.mjs",
    "test:ux": "node e2e/ux.mjs",
    "test:editor": "node e2e/editor.mjs",
    "test:radio": "node e2e/radio.mjs",
    "test:mute": "node e2e/mute.mjs",
    "test:takes": "node e2e/takes.mjs",
    "test:take-sets": "node e2e/take-sets.mjs",
    "test:suggest": "node e2e/suggest.mjs",
    "test:combine": "node e2e/combine.mjs",
    "test:interference": "node e2e/interference.mjs",
    "test:downloads": "node e2e/downloads.mjs",
    "test:workflow": "node e2e/workflow.mjs",
    "test:data": "node e2e/data.mjs",
    "test:navigation": "node e2e/navigation.mjs",
    "test:deploy": "node e2e/deploy.mjs",
    "test:subtitles": "node e2e/subtitles.mjs",
    "test:build-conflicts": "node e2e/build-conflicts.mjs",
    "test:level": "node e2e/level.mjs",
    "test:theme": "node e2e/theme.mjs",
    "test:remote": "node e2e/remote.mjs",
    "test:mobile": "node e2e/mobile.mjs",
    "test:layout": "node e2e/layout.mjs",
    "test:pwa": "node e2e/pwa.mjs",
    "test:visitor": "node e2e/visitor.mjs",
    "icons": "node scripts/make-icons.mjs",
    "perf": "node e2e/perf.mjs",
    "docs:screenshots": "node e2e/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "wavesurfer.js": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12",
    "workbox-window": "^7.4.1"
  }
}
