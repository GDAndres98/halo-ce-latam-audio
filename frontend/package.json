{
  "name": "halo-mcc-localization-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local UI for the Halo MCC Latin American Spanish localization. Talks to scripts/ui/m4_server.py.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python ../scripts/ui/m4_server.py --no-open",
    "dev:web": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "compare:m4": "node e2e/compare-m4.mjs",
    "test:ux": "node e2e/ux.mjs",
    "test:editor": "node e2e/editor.mjs",
    "test:workflow": "node e2e/workflow.mjs",
    "test:data": "node e2e/data.mjs",
    "test:navigation": "node e2e/navigation.mjs",
    "test:deploy": "node e2e/deploy.mjs",
    "test:theme": "node e2e/theme.mjs",
    "perf": "node e2e/perf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "wavesurfer.js": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
