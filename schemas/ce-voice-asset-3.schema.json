{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ce-voice-asset/3",
  "title": "Campaign Evolved voice-asset catalog record (one JSONL line of work/ce/catalog/<mission>.jsonl)",
  "description": "Generated by scripts/catalog/build_ce_catalog.py. Remake-only: never contains MCC identifiers. See docs/dialogue-catalog-design.md §3.1.",
  "type": "object",
  "required": ["schema", "record_id", "ce_line_key", "ce_line_key_evidence", "display_key", "asset_name", "family",
               "family_evidence", "mission", "mission_evidence", "folder", "voice_asset", "entries", "flags",
               "ambiguities", "source_build"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ce-voice-asset/3"},
    "record_id": {"$ref": "#/$defs/record_id"},
    "ce_line_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "ce_line_key_evidence": {"$ref": "#/$defs/evidence"},
    "display_key": {"type": "string", "minLength": 1},
    "asset_name": {"type": "string", "minLength": 1},
    "family": {"enum": ["scripted", "cinematic", "systemic", null]},
    "family_evidence": {"$ref": "#/$defs/evidence"},
    "mission": {"type": ["string", "null"], "pattern": "^M[0-9]+$"},
    "mission_evidence": {"$ref": "#/$defs/evidence"},
    "folder": {"type": ["string", "null"]},
    "voice_asset": {
      "type": "object",
      "required": ["vfs_path", "container", "class", "class_evidence"],
      "properties": {
        "vfs_path": {"type": "string", "pattern": "^Meteorite/Content/"},
        "container": {"type": "string"},
        "class": {"enum": ["HaloAudioVoiceVariations", "HaloAudioSound"]},
        "class_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "flags": {"$ref": "#/$defs/string_set"},
    "ambiguities": {"$ref": "#/$defs/string_set"},
    "source_build": {
      "type": "object",
      "required": ["exe_file_version", "steam_buildid"],
      "properties": {"exe_file_version": {"type": ["string", "null"]}, "steam_buildid": {"type": ["string", "null"]}}
    },
    "blam_sound_tag": {"type": "object", "required": ["evidence"], "properties": {"evidence": {"$ref": "#/$defs/evidence"}}}
  },
  "$defs": {
    "evidence": {"type": "string", "pattern": "^(explicit|explicit:index|derived:[a-z0-9_]+|unresolved)$"},
    "record_id": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)?$"},
    "ce_line_ref": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)?#[0-9]+$"},
    "string_set": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resolved_or_reason": {
      "type": "object",
      "required": ["evidence"],
      "properties": {"evidence": {"$ref": "#/$defs/evidence"}},
      "if": {"properties": {"evidence": {"const": "unresolved"}}},
      "then": {"required": ["reason"]}
    },
    "media_item": {
      "type": "object",
      "required": ["media_id", "media_path", "exists_evidence", "duration_s"],
      "properties": {
        "media_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "media_path": {"type": "string"},
        "exists_evidence": {"$ref": "#/$defs/evidence"},
        "wem_sha256": {"$ref": "#/$defs/sha256"},
        "duration_s": {"type": "null", "description": "Catalog stays metadata-only; decoded durations live in the M1b manifest."}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "required": ["index", "ce_line_ref", "event", "media", "transcription", "subtitles", "lipsync"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "ce_line_ref": {"$ref": "#/$defs/ce_line_ref"},
        "event": {"$ref": "#/$defs/resolved_or_reason"},
        "transcription": {"$ref": "#/$defs/resolved_or_reason"},
        "string_table": {"$ref": "#/$defs/resolved_or_reason"},
        "lipsync": {"$ref": "#/$defs/resolved_or_reason"},
        "media": {
          "type": "object",
          "additionalProperties": {
            "allOf": [{"$ref": "#/$defs/resolved_or_reason"}],
            "properties": {"media": {"type": "array", "items": {"$ref": "#/$defs/media_item"}}}
          }
        },
        "subtitles": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
          "additionalProperties": {"$ref": "#/$defs/resolved_or_reason"}
        }
      }
    }
  }
}
