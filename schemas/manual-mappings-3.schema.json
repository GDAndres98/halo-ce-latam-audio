{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual-mappings/3",
  "title": "User-owned cross-game mapping decisions (mappings/manual_mappings.json, committed). v3: radio_effect is a slot-level flag; audio.fx_request removed (migration: mapping_store.migrate)",
  "description": "The ONLY place CE and MCC identifiers meet. IDs only: no game text, no custom subtitle text, no local paths (those live in the git-ignored manual_mappings.local.json). Every decision is made by the user; tools never create approvals. Audio and subtitle are independent. See docs/dialogue-catalog-design.md §5.",
  "type": "object",
  "required": ["schema", "pins", "slots"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "manual-mappings/3"},
    "pins": {
      "type": "object",
      "required": ["ce_build", "mcc_steam_buildid", "mcc_spanish_fsb_sha256"],
      "additionalProperties": false,
      "properties": {
        "ce_build": {"type": ["string", "null"], "description": "Campaign Evolved exe FileVersion the decisions were made against."},
        "mcc_steam_buildid": {"type": ["string", "null"]},
        "mcc_spanish_fsb_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}
  },
  "$defs": {
    "mapping_id": {"type": "string", "pattern": "^m-[0-9]{6}$"},
    "slot_id": {"type": "string", "pattern": "^es:[^#\\s]+#[0-9]+$"},
    "ce_line_ref": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)?#[0-9]+$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.+-]+Z?)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_status": {"enum": ["draft", "approved", "needs_rework"]},
    "ce_source": {
      "type": "object",
      "required": ["kind", "ce_line_ref", "language"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "ce"},
        "ce_line_ref": {"$ref": "#/$defs/ce_line_ref"},
        "language": {"enum": ["Spanish(Mexico)", "English(US)", "Spanish(Spain)"]}
      }
    },
    "user_source": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {"kind": {"const": "user_recording"}, "ref": {"type": "string", "pattern": "^r-[0-9]{6}$"}}
    },
    "approval": {
      "if": {"required": ["status"], "properties": {"status": {"const": "approved"}}},
      "then": {
        "required": ["approved_at", "fingerprint"],
        "properties": {"approved_at": {"$ref": "#/$defs/date"}, "fingerprint": {"type": "object"}}
      }
    },
    "slot": {
      "type": "object",
      "required": ["mapping_id", "slot_id", "mcc_tag", "match", "audio", "subtitle", "radio_effect", "notes"],
      "additionalProperties": false,
      "properties": {
        "mapping_id": {"$ref": "#/$defs/mapping_id"},
        "slot_id": {"$ref": "#/$defs/slot_id"},
        "mcc_tag": {"type": "string", "pattern": "^sound\\\\dialog\\\\"},
        "match": {
          "type": "object",
          "required": ["status", "ce_line_refs", "decided_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["unreviewed", "matched", "no_equivalent", "deferred"]},
            "ce_line_refs": {"type": "array", "items": {"$ref": "#/$defs/ce_line_ref"}, "uniqueItems": true},
            "decided_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "matched"}}},
             "then": {"properties": {"ce_line_refs": {"minItems": 1}}}},
            {"if": {"properties": {"status": {"enum": ["no_equivalent", "unreviewed"]}}},
             "then": {"properties": {"ce_line_refs": {"maxItems": 0}}}}
          ]
        },
        "audio": {
          "type": "object",
          "required": ["status", "source", "sources", "edit", "fingerprint", "approved_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "status": {"$ref": "#/$defs/decision_status"},
            "source": {"enum": ["keep_original", "ce", "ce_concat", "user_recording", "composite"],
                       "description": "keep_original: Spain audio stays. ce: one CE line. ce_concat: >=2 CE lines in order. user_recording: one local recording. composite: >=2 sources of any kind, in order."},
            "sources": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/ce_source"}, {"$ref": "#/$defs/user_source"}]}},
            "edit": {
              "type": "object",
              "description": "Non-destructive edit recipe (common/audio_edit.py). {trim_start_s, trim_end_s, gap_s} all 0 = no edits (the original pipeline). speed and gain_db were removed on 2026-10-09 (owner decision; one-time migration scripts/validate/migrate_reset_speed_gain.py; volume is the global export gain in config/audio_export.json). The optional fields (added 2026-10-09, no migration needed) are written together by the M4 editor; their rules (ranges, timeline, for_source = the audio source) are checked by the validator and the builder. Part of the audio decision: immutable once approved.",
              "required": ["trim_start_s", "trim_end_s", "gap_s"],
              "additionalProperties": false,
              "properties": {
                "trim_start_s": {"type": "number", "minimum": 0},
                "trim_end_s": {"type": "number", "minimum": 0},
                "gap_s": {"type": "number", "minimum": 0},
                "engine": {"const": "audio-edit/1"},
                "for_source": {
                  "type": "object", "required": ["ce_line_ref", "language"], "additionalProperties": false,
                  "properties": {"ce_line_ref": {"$ref": "#/$defs/ce_line_ref"},
                                 "language": {"enum": ["Spanish(Mexico)", "English(US)", "Spanish(Spain)"]}}
                },
                "cuts": {
                  "type": "array",
                  "items": {"type": "object", "required": ["start_s", "end_s"], "additionalProperties": false,
                            "properties": {"start_s": {"type": "number", "minimum": 0},
                                           "end_s": {"type": "number", "minimum": 0}}}
                },
                "silences": {
                  "type": "array",
                  "items": {"type": "object", "required": ["at_s", "dur_s"], "additionalProperties": false,
                            "properties": {"at_s": {"type": "number", "minimum": 0},
                                           "dur_s": {"type": "number", "minimum": 0.01, "maximum": 5}}}
                },
                "fade_in_ms": {"type": "number", "minimum": 0, "maximum": 500},
                "fade_out_ms": {"type": "number", "minimum": 0, "maximum": 500},
                "crossfade_ms": {"type": "number", "minimum": 0, "maximum": 200},
                "radio": {
                  "type": "object",
                  "required": ["preset", "low_hz", "high_hz", "slope_db_oct", "presence_db", "drive_db", "noise_dbfs"],
                  "additionalProperties": false,
                  "description": "Optional radio filter (owner request 2026-10-13; added without a migration, absent = no filter): band-pass low_hz..high_hz with slope_db_oct on each side, presence peak at the band centre, tanh drive, channel hiss (noise_dbfs, null = none), optional MCC clicks. Applied by common/audio_edit.py after the edits, before the level stage. preset is a label; the stored numbers are what renders. Part of the audio decision.",
                  "properties": {"preset": {"enum": ["spain", "english", "spain_eco", "english_eco", "custom"]},
                                 "low_hz": {"type": "number", "minimum": 100, "maximum": 2000},
                                 "high_hz": {"type": "number", "minimum": 1000, "maximum": 10000},
                                 "slope_db_oct": {"enum": [12, 24, 36]},
                                 "presence_db": {"type": "number", "minimum": -6, "maximum": 12},
                                 "presence_hz": {"type": "number", "minimum": 200, "maximum": 8000, "description": "Optional presence centre (absent = the band's geometric centre)."},
                                 "drive_db": {"type": "number", "minimum": 0, "maximum": 24},
                                 "noise_dbfs": {"type": ["number", "null"], "minimum": -80, "maximum": -30},
                                 "clicks": {"type": "boolean", "description": "MCC's Spain radio key-up click before the line and release/squelch after it (common/radio_clicks.py). Absent = false (recipes from before 2026-10-13 evening)."}}
                },
                "echo": {
                  "type": "object",
                  "required": ["preset", "slap_ms", "slap_db", "delay_ms", "echo_db", "feedback_db", "diffusion", "damping_hz"],
                  "additionalProperties": false,
                  "description": "Optional echo (owner request 2026-10-13, the 'eco' lines; absent = none): a short slap tap (slap_db null = off), a main echo at delay_ms / echo_db with optional feedback (null = one repeat), diffusion (allpass smear) and damping (low-pass in the echo path, null = none). Applied by common/audio_edit.py after the radio filter, before the level; the line gets longer by the ring-out. preset is a label.",
                  "properties": {"preset": {"enum": ["spain", "english", "custom"]},
                                 "slap_ms": {"type": "number", "minimum": 5, "maximum": 80},
                                 "slap_db": {"type": ["number", "null"], "minimum": -40, "maximum": -3},
                                 "delay_ms": {"type": "number", "minimum": 50, "maximum": 600},
                                 "echo_db": {"type": "number", "minimum": -40, "maximum": -3},
                                 "feedback_db": {"type": ["number", "null"], "minimum": -40, "maximum": -3},
                                 "diffusion": {"type": "number", "minimum": 0, "maximum": 1},
                                 "damping_hz": {"type": ["number", "null"], "minimum": 1000, "maximum": 16000}}
                },
                "interference": {
                  "type": "object",
                  "required": ["engine", "points", "guides", "flutter_db"],
                  "additionalProperties": false,
                  "description": "One-off transmission interference (owner prompts 44-45, 2026-10-13), allowed only for Victor 933's damaged transmission (common/interference.LINES; docs/victor933-interference.md). An intensity curve (points t/v, 0..1) on the source timeline drives speech ducking (removed at >= 0.95) and MCC's continuous static; guides are the owner's 11 phrase decisions (drawn and reported, never applied by themselves).",
                  "properties": {"engine": {"const": "interference/2"},
                                 "points": {"type": "array", "items": {
                                   "type": "object", "required": ["t", "v"], "additionalProperties": false,
                                   "properties": {"t": {"type": "number", "minimum": 0},
                                                  "v": {"type": "number", "minimum": 0, "maximum": 1}}}},
                                 "guides": {"type": "array", "items": {
                                   "type": "object", "required": ["label", "kind", "start_s", "end_s"],
                                   "additionalProperties": false,
                                   "properties": {"label": {"type": "string", "maxLength": 80},
                                                  "kind": {"enum": ["partial", "masked"]},
                                                  "start_s": {"type": "number", "minimum": 0},
                                                  "end_s": {"type": "number", "minimum": 0}}}},
                                 "flutter_db": {"type": "number", "minimum": 0, "maximum": 6}}
                },
                "loudness": {
                  "type": "object", "required": ["mode", "offset_db"], "additionalProperties": false,
                  "description": "Legacy (loudness matching removed 2026-10-11): only 'off' remains in older recipes.",
                  "properties": {"mode": {"enum": ["off"]},
                                 "offset_db": {"type": "number", "minimum": 0, "maximum": 0}}
                }
              }
            },
            "fingerprint": {"type": ["object", "null"]},
            "approved_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {"$ref": "#/$defs/approval"},
            {"if": {"properties": {"source": {"const": "keep_original"}}}, "then": {"properties": {"sources": {"maxItems": 0}}}},
            {"if": {"properties": {"source": {"const": "ce"}}},
             "then": {"properties": {"sources": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/ce_source"}}}}},
            {"if": {"properties": {"source": {"const": "ce_concat"}}},
             "then": {"properties": {"sources": {"minItems": 2, "items": {"$ref": "#/$defs/ce_source"}}}}},
            {"if": {"properties": {"source": {"const": "user_recording"}}},
             "then": {"properties": {"sources": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/user_source"}}}}},
            {"if": {"properties": {"source": {"const": "composite"}}}, "then": {"properties": {"sources": {"minItems": 2}}}}
          ]
        },
        "subtitle": {
          "type": "object",
          "required": ["status", "source", "ce_locres", "custom_ref", "mcc_key_hash", "mcc_key_verification",
                       "fingerprint", "approved_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "status": {"$ref": "#/$defs/decision_status"},
            "source": {"enum": ["keep_original", "ce_locres", "custom", "none"]},
            "ce_locres": {
              "anyOf": [
                {"type": "null"},
                {"type": "object", "required": ["ce_line_ref", "culture"], "additionalProperties": false,
                 "properties": {"ce_line_ref": {"$ref": "#/$defs/ce_line_ref"}, "culture": {"enum": ["es-MX", "en", "es-ES"]}}}
              ]
            },
            "custom_ref": {"type": ["string", "null"], "pattern": "^c-[0-9]{6}$"},
            "mcc_key_hash": {"type": ["integer", "null"], "description": "Target row in SP_Halo1.bin. Must stay null until blocker B1 yields a verified link."},
            "mcc_key_verification": {"type": ["string", "null"], "pattern": "^v-[0-9]{6}$"},
            "fingerprint": {"type": ["object", "null"]},
            "approved_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {"$ref": "#/$defs/approval"},
            {"if": {"properties": {"source": {"const": "ce_locres"}}},
             "then": {"properties": {"ce_locres": {"type": "object"}, "custom_ref": {"type": "null"}}},
             "else": {"properties": {"ce_locres": {"type": "null"}}}},
            {"if": {"properties": {"source": {"const": "custom"}}},
             "then": {"properties": {"custom_ref": {"type": "string"}}},
             "else": {"properties": {"custom_ref": {"type": "null"}}}},
            {"if": {"properties": {"mcc_key_hash": {"type": "integer"}}},
             "then": {"properties": {"mcc_key_verification": {"type": "string"}}}}
          ]
        },
        "radio_effect": {
          "type": "object",
          "description": "Owner's manual 'Needs radio effect' flag (v1.1 metadata for the build pipeline; no effect is applied). Independent of the audio and subtitle approvals: toggling it never changes an approved object. It may only be true while the audio uses selected CE audio (validator).",
          "required": ["needed", "set_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "needed": {"type": "boolean"},
            "set_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          }
        },
        "different_but_fits": {
          "type": "object",
          "description": "Optional owner flag (added 2026-10-08, no migration needed): the matched CE dialogue differs from the MCC line, but the owner judges it fits the scene. Same rules as radio_effect: independent of approvals, every change bumps its revision; may only be true while the match lists CE lines (validator). Missing = not marked.",
          "required": ["marked", "set_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "marked": {"type": "boolean"},
            "set_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          }
        },
        "needs_recording": {
          "type": "object",
          "description": "Optional owner flag (added 2026-10-11, no migration needed): the line needs a new recording (for example, no Campaign Evolved line fits). Independent of the audio and subtitle approvals; every change bumps its revision. Written only once first marked; missing = not marked.",
          "required": ["marked", "set_at", "revision"],
          "additionalProperties": false,
          "properties": {
            "marked": {"type": "boolean"},
            "set_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
            "revision": {"type": "integer", "minimum": 1}
          }
        },
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
