{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcc-dialogue-tag/3",
  "title": "MCC Halo CE dialogue-tag catalog record (one JSONL line of work/mcc/catalog/<level>.jsonl)",
  "description": "Generated by scripts/catalog/build_mcc_catalog.py. MCC-only: never contains Campaign Evolved identifiers. See docs/dialogue-catalog-design.md §4.1.",
  "type": "object",
  "required": ["schema", "mcc_tag", "tag_name", "level", "kind", "sequence", "speaker_from_name", "name_evidence",
               "lst", "samples", "slot_ids", "flags", "subtitle", "source"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mcc-dialogue-tag/3"},
    "mcc_tag": {"type": "string", "pattern": "^sound\\\\dialog\\\\"},
    "tag_name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "level": {"type": ["string", "null"]},
    "kind": {"enum": ["scripted", "flavor", "insert", "other"]},
    "sequence": {"type": ["string", "null"]},
    "speaker_from_name": {"type": ["string", "null"]},
    "name_evidence": {"$ref": "#/$defs/evidence"},
    "lst": {
      "type": "object",
      "required": ["spanish", "english"],
      "additionalProperties": false,
      "properties": {"spanish": {"$ref": "#/$defs/lst"}, "english": {"$ref": "#/$defs/lst"}}
    },
    "samples": {
      "type": "object",
      "required": ["spanish", "english"],
      "additionalProperties": false,
      "properties": {
        "spanish": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/sample"}], "required": ["slot_id"]}},
        "english": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/sample"}], "not": {"required": ["slot_id"]}}}
      }
    },
    "slot_ids": {"type": "array", "items": {"$ref": "#/$defs/slot_id"}, "uniqueItems": true},
    "flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "subtitle": {
      "type": "object",
      "required": ["key_hash", "evidence"],
      "properties": {"key_hash": {"type": ["integer", "null"]}, "evidence": {"$ref": "#/$defs/evidence"}},
      "if": {"properties": {"evidence": {"const": "unresolved"}}},
      "then": {"required": ["reason"], "properties": {"key_hash": {"type": "null"}}}
    },
    "source": {
      "type": "object",
      "required": ["spanish_fsb_sha256", "english_fsb_sha256", "steam"],
      "properties": {
        "spanish_fsb_sha256": {"$ref": "#/$defs/sha256"},
        "english_fsb_sha256": {"$ref": "#/$defs/sha256"},
        "steam": {"type": "object", "required": ["steam_buildid"]}
      }
    },
    "unresolved": {"type": "array", "items": {"type": "object", "required": ["field", "reason"]}}
  },
  "$defs": {
    "evidence": {"type": "string", "pattern": "^(explicit|explicit:index|derived:[a-z0-9_]+|unresolved)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slot_id": {"type": "string", "pattern": "^es:[^#\\s]+#[0-9]+$"},
    "lst": {
      "type": "object",
      "required": ["evidence", "agrees_with_name_table"],
      "properties": {
        "first_sample_index": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 0},
        "evidence": {"$ref": "#/$defs/evidence"},
        "agrees_with_name_table": {"type": "boolean"}
      }
    },
    "sample": {
      "type": "object",
      "required": ["index", "subsong", "name_in_bank", "name_occurrence_in_bank", "ordinal_in_tag", "codec", "freq",
                   "channels", "sample_count", "duration_s", "data_sha256", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "subsong": {"type": "integer", "minimum": 1},
        "slot_id": {"$ref": "#/$defs/slot_id"},
        "name_in_bank": {"type": "string", "minLength": 1},
        "name_occurrence_in_bank": {"type": "integer", "minimum": 0},
        "ordinal_in_tag": {"type": "integer", "minimum": 0},
        "codec": {"type": "string"},
        "freq": {"type": ["integer", "string"]},
        "channels": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 0},
        "duration_s": {"type": ["number", "null"]},
        "data_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
